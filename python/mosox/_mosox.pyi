from typing import Literal

import pyarrow as pa

__version__: str

class MosoxError(Exception): ...

class Dat:
    def __init__(self, text: str) -> None: ...
    @staticmethod
    def from_file(path: str) -> Dat: ...

# A parsed `.dat` file, or tables with param defaults and whether they patch lower layers
Layer = Dat | tuple[dict[str, pa.Table], dict[str, float], bool]

class Model:
    def __init__(self, text: str) -> None: ...
    @staticmethod
    def from_file(path: str) -> Model: ...
    def compile(self, layers: list[Layer], prune: bool, check: bool) -> Matrix: ...
    def declarations(
        self,
    ) -> list[tuple[Literal["set", "param", "var", "constraint", "objective"], str, list[str], int | None]]: ...

class Matrix:
    @property
    def num_rows(self) -> int: ...
    @property
    def num_cols(self) -> int: ...
    @property
    def num_nonzeros(self) -> int: ...
    def to_mps(self) -> str: ...
    def solve(
        self,
        options: list[tuple[str, str]],
        verbose: bool,
        keep: set[str] | None,
    ) -> tuple[str, float, list[tuple[str, pa.Table]], list[tuple[str, pa.Table]]]: ...
